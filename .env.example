# ── Credential resolution ─────────────────────────────────────────
# The server resolves the API key in this order:
#   1. BUGHERD_API_KEY env var (below)
#   2. BUGHERD_API_KEY_FILE env var (path to a file holding the key)
#   3. Default credential file: ~/.config/bugherd-mcp/api-key (mode 0600)
# The project ID resolves the same way:
#   BUGHERD_PROJECT_ID → BUGHERD_PROJECT_ID_FILE → ~/.config/bugherd-mcp/project-id
#
# Recommended for values shared across projects: skip the env vars entirely,
# write them once to the default files, and keep each project's .mcp.json a
# bare launch block (no `env` needed). Set up the files with:
#   mkdir -p -m 700 ~/.config/bugherd-mcp
#   printf %s 'YOUR_API_KEY'    > ~/.config/bugherd-mcp/api-key
#   printf %s 'YOUR_PROJECT_ID' > ~/.config/bugherd-mcp/project-id
#   chmod 600 ~/.config/bugherd-mcp/api-key ~/.config/bugherd-mcp/project-id

# Your BugHerd API key (found in Settings > General). Overrides the credential file.
BUGHERD_API_KEY=

# The numeric ID of your BugHerd project. Overrides the credential file.
BUGHERD_PROJECT_ID=

# ── Optional: column label shortcuts ──────────────────────────────
# Map the "pending" / "in_progress" / "done" shorthands to your column names.
# BUGHERD_COLUMN_PENDING=Backlog
# BUGHERD_COLUMN_IN_PROGRESS=In Progress
# BUGHERD_COLUMN_DONE=Done

# ── Optional tuning ───────────────────────────────────────────────
# Max concurrent requests.
# BUGHERD_MAX_CONCURRENT_REQUESTS=5
# Max ms to wait on a 429 retry before giving up.
# BUGHERD_MAX_RETRY_DELAY_MS=30000
# Max retries on 429.
# BUGHERD_MAX_RETRIES=3
